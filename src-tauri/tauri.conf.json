{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContextDock",
  "version": "0.10.1",
  "identifier": "com.contextdock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ContextDock",
        "visible": false,
        "width": 1180,
        "height": 780,
        "minWidth": 780,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Your project documentation, in one place.",
    "category": "Productivity",
    "resources": { "icons/icon.ico": "ContextDock.ico" },
    "windows": {
      "nsis": {
        "installerHooks": "windows/ContextDock_Installer_Hooks_v1.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["contextdock"] } } }
}
